# =============================================================================
# pxpipe — ОПИСАНИЕ КОНТУРА
#
#   cp deploy/contour.example.env deploy/contour.env   &&   $EDITOR deploy/contour.env
#
# contour.env не коммитится (deploy/.gitignore). Здесь нет секретов — только
# топология. Секреты (ключи, токены) живут в ~/.ssh и в /opt/pxpipe/.env.
#
# Заполненный пример ниже = рабочий контур "frankfurt-147" на 2026-09-16.
# =============================================================================

# ---------- 0. Идентификация ----------
CONTOUR_NAME=frankfurt-147

# Пин исходников. Этот SHA — проверенное рабочее состояние, с которого снят
# весь этот deploy-каталог. НЕ заменяй на "master" не проверив verify.sh.
PXPIPE_REPO=https://github.com/AndrewMoryakov/pxpipe.git
PXPIPE_REF=090dd3964e9ad7429bbba65be7cf1704d71d024e
PXPIPE_DIR=/opt/pxpipe

# ---------- 1. Роль egress ----------
# Как pxpipe выходит к api.anthropic.com / chatgpt.com.
#
#   direct          — хост ходит наружу сам.
#   upstream-proxy  — IP хоста заблокирован (Cloudflare 403), трафик уходит
#                     в чужой tinyproxy через SSH-туннель.
#
# КАК ВЫБРАТЬ — выполни на самом gateway-хосте:
#   curl -s -o /dev/null -w '%{http_code}\n' --max-time 15 --noproxy '*' \
#        https://api.anthropic.com/v1/messages
#   405 -> доступен, ставь direct.   403 -> заблокирован, ставь upstream-proxy.
#   (405 = "метод не тот", т.е. TLS и маршрут живы. Это успех, не ошибка.)
EGRESS_MODE=upstream-proxy

# ---------- 2. Параметры upstream-proxy (нужны только при EGRESS_MODE=upstream-proxy)
# Хост, у которого egress не заблокирован и который уже держит tinyproxy.
EGRESS_SSH_USER=hopt
EGRESS_SSH_HOST=81.85.50.83
EGRESS_SSH_KEY=/root/.ssh/id_ed25519_tashkent_tunnel
# Порт tinyproxy НА egress-хосте (слушает на его 127.0.0.1).
EGRESS_PROXY_PORT=3128
# Адрес host-стороны туннеля = gateway docker-сети pxpipe-local.
# Контейнер ходит сюда; это НЕ overlay/NetBird адрес и не должен им быть.
EGRESS_BIND_ADDR=172.30.250.1
EGRESS_NO_PROXY=localhost,127.0.0.1,172.30.250.0/24

# ---------- 3. Gateway-хост ----------
GATEWAY_SSH_USER=root
GATEWAY_SSH_HOST=185.177.219.147
# Порт, на котором pxpipe слушает НА gateway (только loopback).
GATEWAY_PXPIPE_PORT=47821
# Loopback-порты, которые обязан закрывать pxpipe-localhost-guard.
# 47821 = pxpipe, 33080/33081 = netbird-server/dashboard.
GUARD_PORTS=33080 33081 47821

# ---------- 4. Апстримы и модели ----------
OPENAI_UPSTREAM=https://chatgpt.com
PXPIPE_MODELS=claude-opus-5,claude-opus-4-8,claude-sonnet-5,claude-fable-5,gpt-5.6-terra,gpt-5.6-sol,gpt-5.6-lun

# ---------- 5. Клиент (Windows) ----------
# Локальный порт на рабочей машине. Клиенты смотрят сюда.
# Туннель: 127.0.0.1:CLIENT_PXPIPE_PORT -> GATEWAY:GATEWAY_PXPIPE_PORT
CLIENT_PXPIPE_PORT=47822
CLIENT_SSH_KEY=~/.ssh/id_ed25519_hopt
CLIENT_LOG_DIR=C:\ProgramData\pxpipe
CLIENT_BIN_DIR=%USERPROFILE%\bin

# Keeper (pxpipe-tunnel.ps1): пороги живучести.
KEEPER_HEARTBEAT_SEC=60
KEEPER_PROBE_SEC=30
KEEPER_PROBE_FAIL_MAX=3
KEEPER_PROBE_GRACE_SEC=45
KEEPER_BACKOFF_MIN=5
KEEPER_BACKOFF_MAX=300
KEEPER_STABLE_SEC=120
