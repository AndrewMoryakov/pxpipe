# =============================================================================
# pxpipe — CONTOUR DESCRIPTION
#
#   cp deploy/contour.example.env deploy/contour.env   &&   $EDITOR deploy/contour.env
#
# contour.env is not committed (deploy/.gitignore). There are no secrets here —
# topology only. Secrets (keys, tokens) live in ~/.ssh and in /opt/pxpipe/.env.
#
# The filled-in example below is the live "frankfurt-147" contour as of 2026-09-16.
# =============================================================================

# ---------- 0. Identity ----------
CONTOUR_NAME=frankfurt-147

# Pinned sources. This SHA is the verified working state this whole deploy/
# directory was captured from. Do NOT move it to "master" without running verify.sh.
PXPIPE_REPO=https://github.com/AndrewMoryakov/pxpipe.git
PXPIPE_REF=090dd3964e9ad7429bbba65be7cf1704d71d024e
PXPIPE_DIR=/opt/pxpipe

# ---------- 1. Egress role ----------
# How pxpipe reaches api.anthropic.com / chatgpt.com.
#
#   direct          — the host reaches the internet itself.
#   upstream-proxy  — the host IP is blocked (Cloudflare 403); traffic is routed
#                     through someone else's tinyproxy over an SSH tunnel.
#
# HOW TO CHOOSE — run this on the gateway host itself:
#   curl -s -o /dev/null -w '%{http_code}\n' --max-time 15 --noproxy '*' \
#        https://api.anthropic.com/v1/messages
#   405 -> reachable, set direct.    403 -> blocked, set upstream-proxy.
#   (405 means "wrong method", i.e. TLS and routing are alive. That is success.)
EGRESS_MODE=upstream-proxy

# ---------- 2. upstream-proxy parameters (only when EGRESS_MODE=upstream-proxy)
# A host whose egress is not blocked and which already runs tinyproxy.
EGRESS_SSH_USER=hopt
EGRESS_SSH_HOST=81.85.50.83
EGRESS_SSH_KEY=/root/.ssh/id_ed25519_tashkent_tunnel
# tinyproxy port ON the egress host (bound to its own 127.0.0.1).
EGRESS_PROXY_PORT=3128
# Host-side bind address of the tunnel = gateway of the pxpipe-local docker network.
# The container connects here. This must NOT be an overlay/NetBird address.
EGRESS_BIND_ADDR=172.30.250.1
EGRESS_NO_PROXY=localhost,127.0.0.1,172.30.250.0/24

# ---------- 3. Gateway host ----------
GATEWAY_SSH_USER=root
GATEWAY_SSH_HOST=185.177.219.147
# Port pxpipe listens on AT the gateway (loopback only).
GATEWAY_PXPIPE_PORT=47821
# Loopback ports that pxpipe-localhost-guard must close.
# 47821 = pxpipe, 33080/33081 = netbird-server/dashboard.
GUARD_PORTS=33080 33081 47821

# ---------- 4. Upstreams and models ----------
OPENAI_UPSTREAM=https://chatgpt.com
PXPIPE_MODELS=claude-opus-5,claude-opus-4-8,claude-sonnet-5,claude-fable-5,gpt-5.6-terra,gpt-5.6-sol,gpt-5.6-lun

# ---------- 5. Client (Windows) ----------
# Local port on the workstation. Clients point here.
# Tunnel: 127.0.0.1:CLIENT_PXPIPE_PORT -> GATEWAY:GATEWAY_PXPIPE_PORT
CLIENT_PXPIPE_PORT=47822
# Ports of pre-existing local networking that canary.ps1 probes. These are NOT
# pxpipe: work = SSH tunnel into the work contour (start-tashkent-tunnels.ps1),
# clash = the Clash/verge mixed port.
# On a contour without them the canary still probes, so set real values.
CLIENT_WORK_PORT=19443
CLIENT_CLASH_PORT=7897
CLIENT_SSH_KEY=~/.ssh/id_ed25519_hopt
CLIENT_LOG_DIR=C:\ProgramData\pxpipe
CLIENT_BIN_DIR=%USERPROFILE%\bin

# Keeper (pxpipe-tunnel.ps1): liveness thresholds.
KEEPER_HEARTBEAT_SEC=60
KEEPER_PROBE_SEC=30
KEEPER_PROBE_FAIL_MAX=3
KEEPER_PROBE_GRACE_SEC=45
KEEPER_BACKOFF_MIN=5
KEEPER_BACKOFF_MAX=300
KEEPER_STABLE_SEC=120
